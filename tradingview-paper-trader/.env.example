# moomoo OpenD gateway (must already be running & logged in)
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
# index into your moomoo paper trading accounts, 0 = first/default
ACC_INDEX=0

# Shared secret TradingView must include in the alert JSON body.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Fallback share count if an alert doesn't specify "qty"
DEFAULT_QTY=1
# Safety cap — orders above this qty are rejected before reaching the broker
MAX_QTY=10000

DB_PATH=trades.db

APP_HOST=0.0.0.0
APP_PORT=5000
