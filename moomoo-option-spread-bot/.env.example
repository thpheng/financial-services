# moomoo OpenD gateway (must already be running & logged in via the desktop app)
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
ACC_INDEX=0

# SIMULATE (paper) or REAL. Start on SIMULATE. Always.
TRADING_MODE=SIMULATE
# Only read when TRADING_MODE=REAL. Your moomoo trade/unlock password.
# Never commit this file with a real value filled in.
TRADE_UNLOCK_PASSWORD=

# The exact contract to trade, e.g. US.AMD260116C00150000
# Find it with: python3 find_option_code.py US.AMD 2026-01-16
OPTION_CODE=
QTY=1

# Set this to the REAL minimum price increment for this specific contract
# (commonly 0.01 or 0.05 for US options) -- get it wrong and orders get
# rejected or silently rounded by the exchange.
STEP_SIZE=0.05
NUM_STEPS=1
MIN_SPREAD_TO_ENTER=0.20

POLL_INTERVAL_SECONDS=2
BUY_TIMEOUT_SECONDS=60
SELL_REPRICE_AFTER_SECONDS=30
SELL_REPRICE_STEP_TICKS=1
MAX_SELL_REPRICES=5

DB_PATH=trades.db
