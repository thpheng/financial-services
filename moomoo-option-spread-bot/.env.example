# moomoo OpenD gateway (must already be running & logged in via the desktop app)
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
ACC_INDEX=0
# Leave 0 unless orders get rejected with "Account does not support trading
# X" -- then run list_accounts.py, find the acc_id approved for options
# paper trading, and put it here to target that account precisely.
ACC_ID=0

# SIMULATE (paper) or REAL. Start on SIMULATE. Always.
TRADING_MODE=SIMULATE
# Only read when TRADING_MODE=REAL. Your moomoo trade/unlock password.
# Never commit this file with a real value filled in.
TRADE_UNLOCK_PASSWORD=

# The exact contract to trade, e.g. US.AMD260116C00150000. Leave blank to
# have contract_selector.py resolve one dynamically at startup instead (see
# UNDERLYING/OPTION_TYPE/MIN_DTE_DAYS/MAX_DTE_DAYS below). Setting this
# manually always wins over dynamic resolution.
# Find one by hand with: python3 find_option_code.py US.AMD 2026-01-16
OPTION_CODE=

# --- dynamic contract resolution (only used when OPTION_CODE is blank) ------
UNDERLYING=US.AMD
# CALL or PUT to force a side. Leave blank to ask StockV3Recommender's rules
# engine for the current bias each run (requires that project's server
# running at RECOMMENDER_URL) -- the bot refuses to start if it has no
# actionable signal rather than guess a direction.
OPTION_TYPE=
# Nearest eligible expiry must be at least this many days out (avoids 0DTE
# gamma/theta risk) and at most this many ("within a week").
MIN_DTE_DAYS=1
MAX_DTE_DAYS=7
RECOMMENDER_URL=http://localhost:8000

QTY=1

# Set this to the REAL minimum price increment for this specific contract
# (commonly 0.01 or 0.05 for US options) -- get it wrong and orders get
# rejected or silently rounded by the exchange.
STEP_SIZE=0.05
NUM_STEPS=1
MIN_SPREAD_TO_ENTER=0.20

# moomoo caps order_list_query at 10 calls/30s; the bot calls it once per
# poll while watching an order, so keep this above 3 -- 4 leaves margin.
POLL_INTERVAL_SECONDS=4
BUY_TIMEOUT_SECONDS=60
SELL_REPRICE_AFTER_SECONDS=30
SELL_REPRICE_STEP_TICKS=1
MAX_SELL_REPRICES=5
# Stop the bot automatically after this many consecutive failed polls,
# instead of retrying forever / needing a manual Ctrl+C.
MAX_CONSECUTIVE_ERRORS=5

DB_PATH=trades.db
